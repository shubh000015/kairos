{
  "manifest_version": 3,
  "name": "Kairos for YouTube",
  "version": "1.0.0",
  "description": "Turns passive lecture watching into active recall. Every 10 minutes the video pauses until you summarise what you just heard. Park distracting thoughts without leaving the tab.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Kairos",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
