# Optional. Server LLM for the leftovers: tasks no breakdown template matches,
# richer Stuck explanations, LLM-made puzzles. Only used when a user turns on
# "Cloud AI fallback" in Settings. The app works fully on-device without this.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, Azure, Groq, Ollama, LM Studio, OpenRouter...).
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=

# Model name for the breakdown call. Default: gpt-4o-mini
OPENAI_MODEL=

# Optional. YouTube Data API v3 — search in Study music and lectures.
# Create a key at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Playback of pasted links and study stations works without this.
YOUTUBE_API_KEY=

# Optional. Cognitive Audio Engine (Spotify). Create an app at
# https://developer.spotify.com/dashboard, add the redirect URIs
#   http://127.0.0.1:3000/app/spotify/callback
#   https://<your-vercel-domain>/app/spotify/callback
# and paste the Client ID here. PKCE flow: no client secret is needed or used.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Optional. Focus Pods presence across serverless instances. Without these the
# pods API keeps presence in process memory (fine for one server / local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Background sync of the local-first IndexedDB data to your own backend
# (Supabase Edge Function, Firebase Function, any HTTPS endpoint). Changed stores
# are POSTed when online; the device remains the source of truth.
NEXT_PUBLIC_SYNC_URL=
# Optional bearer token sent with sync requests.
NEXT_PUBLIC_SYNC_KEY=
